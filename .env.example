# ── Database ──
# Préfixées KEBPAY_ pour éviter toute collision avec des variables génériques
# (DB_PASSWORD, REDIS_HOST...) déjà présentes dans l'environnement shell d'une
# machine partagée entre plusieurs projets — Docker Compose donne priorité aux
# variables shell sur celles du fichier .env, une collision serait silencieuse.
KEBPAY_DB_NAME=kebpay
KEBPAY_DB_USER=kebpay
KEBPAY_DB_PASSWORD=change-me
KEBPAY_DB_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/kebpay

# ── Redis ──
KEBPAY_REDIS_HOST=localhost
KEBPAY_REDIS_PORT=6379
KEBPAY_REDIS_PASSWORD=

# ── Wave ──
# Wave émet des clés API scopées par produit (Checkout, Balance, Payout) :
# - WAVE_CHECKOUT_API_KEY : pour les encaissements (scope checkout_api)
# - WAVE_PAYOUT_API_KEY : pour les versements / paiements programmés (scope payouts_api)
WAVE_BASE_URL=https://api.wave.com
WAVE_CHECKOUT_API_KEY=change-me
WAVE_PAYOUT_API_KEY=change-me
WAVE_WEBHOOK_SECRET=change-me
WAVE_SUCCES_URL=https://kebpay.internal/wave/success
WAVE_ERROR_URL=https://kebpay.internal/wave/error

# ── Orange Money (API Sonatel — developer.orange-sonatel.com) ──
ORANGE_MONEY_BASE_URL=https://api.sandbox.orange-sonatel.com
ORANGE_MONEY_CLIENT_ID=change-me
ORANGE_MONEY_CLIENT_SECRET=change-me
ORANGE_MONEY_MERCHANT_CODE=change-me
ORANGE_MONEY_MERCHANT_NAME=KebPay
# Valeur choisie par nous, à déclarer via POST /api/notification/v1/merchantcallback
ORANGE_MONEY_CALLBACK_API_KEY=change-me
ORANGE_MONEY_SUCCESS_REDIRECT_URL=https://kebpay.internal/om/success
ORANGE_MONEY_CANCEL_REDIRECT_URL=https://kebpay.internal/om/cancel
ORANGE_MONEY_QRCODE_VALIDITY_SECONDS=300

# ── Sécurité applicative ──
# Clé maîtresse utilisée par le script de génération de clés API plateforme (BCrypt)
API_KEY_BCRYPT_STRENGTH=12
# Hash BCrypt (généré via `make keys` — c'est le HASH affiché, pas la clé en clair kbp_...)
# attendu dans le header X-Admin-Key pour les endpoints /api/v1/admin/**. IMPORTANT :
# entourer la valeur de guillemets simples — ce fichier est "sourcé" par le Makefile
# (set -a; . .env), et un hash BCrypt contient des `$` que bash interpréterait comme des
# variables si la valeur n'est pas protégée.
ADMIN_KEY_HASH='$2a$12$change-me-with-real-bcrypt-hash'
# Origines autorisées en CORS pour le dashboard front (séparées par des virgules si plusieurs)
KEBPAY_DASHBOARD_ORIGINS=http://localhost:5183

# ── Divers ──
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8082
