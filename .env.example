# ── Database ──
# Préfixées PAYLANCE_ pour éviter toute collision avec des variables génériques
# (DB_PASSWORD, REDIS_HOST...) déjà présentes dans l'environnement shell d'une
# machine partagée entre plusieurs projets — Docker Compose donne priorité aux
# variables shell sur celles du fichier .env, une collision serait silencieuse.
PAYLANCE_DB_NAME=paylance
PAYLANCE_DB_USER=paylance
PAYLANCE_DB_PASSWORD=change-me
PAYLANCE_DB_PORT=5434
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5434/paylance

# ── Redis ──
PAYLANCE_REDIS_HOST=localhost
PAYLANCE_REDIS_PORT=6383
# Adminer (interface web de la base) : http://localhost:8083
PAYLANCE_ADMINER_PORT=8083
PAYLANCE_REDIS_PASSWORD=

# ── Prestataires (configuration globale NON secrète) ──
# Aucune clé Wave / Orange Money ici : chaque client Paylance connecte SES propres comptes
# marchands depuis le dashboard (identifiants chiffrés en base).
WAVE_BASE_URL=https://api.wave.com
ORANGE_MONEY_LIVE_BASE_URL=https://api.orange-sonatel.com
ORANGE_MONEY_TEST_BASE_URL=https://api.sandbox.orange-sonatel.com
ORANGE_MONEY_QRCODE_VALIDITY_SECONDS=300

# ── Sécurité applicative ──
# Clé maîtresse AES-256 (32 octets encodés en base64) chiffrant les secrets clients en base.
# Valeur FACTICE ci-dessous (32 octets nuls) : à remplacer, générer avec `openssl rand -base64 32`.
PAYLANCE_ENCRYPTION_MASTER_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Keycloak (dashboard) : laisser vide tant que Keycloak n'est pas branché.
PAYLANCE_KEYCLOAK_ISSUER_URI=
# URL publique de l'API (affichée aux clients pour configurer leurs webhooks prestataires)
PAYLANCE_PUBLIC_BASE_URL=http://localhost:8082
# Origines autorisées en CORS pour le dashboard front (séparées par des virgules si plusieurs)
PAYLANCE_DASHBOARD_ORIGINS=http://localhost:5173

# ── Divers ──
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8082
# Port actuator (métriques/Prometheus), lié à 127.0.0.1
PAYLANCE_MANAGEMENT_PORT=8092
